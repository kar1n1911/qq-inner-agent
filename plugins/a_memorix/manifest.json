{
  "name": "a_memorix",
  "version": "0.1.0",
  "core_api_version": {
    "major": 1,
    "min_minor": 0,
    "max_minor": null
  },
  "protocol": {
    "name": "gRPC",
    "schema_version": "a_memorix.api.v1",
    "schema": [
      "rust/proto/a_memorix/api/v1/namespace.proto",
      "rust/proto/a_memorix/api/v1/memory.proto"
    ]
  },
  "entry": {
    "type": "configured_grpc",
    "endpoint_param": "endpoint"
  },
  "kind": "Memory",
  "transport": "Remote",
  "capabilities": {
    "supported": [
      "text_retrieval"
    ],
    "unsupported": [
      "reset_scope"
    ],
    "unknown": [
      "embeddings",
      "relation_extraction"
    ]
  },
  "dependencies": [],
  "config_schema": [
    {
      "key": "endpoint",
      "label": "gRPC endpoint",
      "type": "string",
      "required": true,
      "secret": false
    },
    {
      "key": "token",
      "label": "gRPC token",
      "type": "string",
      "required": false,
      "secret": true
    }
  ],
  "host_permissions": [
    {
      "type": "grpc",
      "endpoint": "configured:endpoint"
    }
  ],
  "hot_reload": false,
  "operations": [
    "upsert",
    "forget",
    "retrieve"
  ],
  "enablement_requirement": "gRPC namespace capability probe must succeed and report text_retrieval"
}
