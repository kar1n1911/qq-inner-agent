{
  "name": "claude",
  "version": "0.1.0",
  "core_api_version": {
    "major": 1,
    "min_minor": 0,
    "max_minor": null
  },
  "protocol": {
    "name": "HTTP JSON",
    "schema_version": "provider_api",
    "completion_path": "/v1/messages",
    "models_path": "/v1/models"
  },
  "entry": {
    "type": "configured_http",
    "base_url_param": "base_url"
  },
  "kind": "Model",
  "transport": "Remote",
  "capabilities": {
    "supported": [
      "truncation_signal",
      "list_models",
      "text_completion"
    ],
    "unsupported": [
      "thinking_field",
      "json_mode"
    ],
    "unknown": [
      "context_window_tokens"
    ]
  },
  "dependencies": [],
  "config_schema": [
    {
      "key": "base_url",
      "label": "API base URL",
      "type": "string",
      "required": true,
      "secret": false
    },
    {
      "key": "model",
      "label": "Model ID",
      "type": "string",
      "required": true,
      "secret": false
    },
    {
      "key": "api_key",
      "label": "API key",
      "type": "string",
      "required": true,
      "secret": true
    },
    {
      "key": "context_window_tokens",
      "label": "Context window tokens (0 = unknown)",
      "type": "integer",
      "required": false,
      "secret": false
    }
  ],
  "host_permissions": [
    {
      "type": "http",
      "origin": "configured:base_url"
    }
  ],
  "hot_reload": false,
  "operations": [
    "streaming_completion"
  ]
}
