{
  "name": "ollama",
  "version": "0.1.0",
  "core_api_version": {
    "major": 1,
    "min_minor": 0,
    "max_minor": null
  },
  "protocol": {
    "name": "HTTP JSON",
    "schema_version": "provider_api",
    "completion_path": "/api/chat",
    "models_path": "/api/tags"
  },
  "entry": {
    "type": "built_in",
    "adapter": "plugins/ollama/adapter.rs"
  },
  "kind": "Model",
  "transport": "InProcess",
  "capabilities": {
    "supported": [
      "truncation_signal",
      "list_models",
      "text_completion",
      "json_mode"
    ],
    "unsupported": [
      "thinking_field"
    ],
    "unknown": [
      "context_window_tokens"
    ]
  },
  "dependencies": [],
  "config_schema": [
    {
      "key": "base_url",
      "label": "Ollama URL",
      "type": "string",
      "required": true,
      "secret": false
    },
    {
      "key": "model",
      "label": "Model ID",
      "type": "string",
      "required": true,
      "secret": false
    },
    {
      "key": "context_window_tokens",
      "label": "Context window tokens (0 = unknown)",
      "type": "integer",
      "required": false,
      "secret": false
    }
  ],
  "host_permissions": [
    {
      "type": "http",
      "origin": "configured:base_url"
    }
  ],
  "hot_reload": false,
  "status": "skeleton",
  "skeleton_reason": "The Rust HTTP adapter is compiled into the core, but factory.rs requires Sidecar and a managed executable that this package does not contain.",
  "operations": [
    "streaming_completion"
  ]
}
